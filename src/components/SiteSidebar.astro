---
import { site, pathWithBase } from "@/config/site";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.slice(basePath.length).replace(/\/$/, "") || "/";
const navItems = [
  { href: "/", label: "全部" },
  ...site.sections.map((section) => ({ href: `/sections/${section.id}`, label: section.name })),
  { href: "/links", label: "链接" }
];
---

<aside class="sidebar" aria-label="站点导航">
  <a class="brand" href={pathWithBase("/")}>
    <span class="brand-mark">G</span>
    <span>
      <strong>{site.title}</strong>
      <small class="intro">{site.navIntro}</small>
    </span>
  </a>

  <nav class="section-nav" aria-label="博客导航">
    {navItems.map(({ href, label }) => (
      <a
        class:list={["nav-link", currentPath === href && "is-active"]}
        aria-current={currentPath === href ? "page" : undefined}
        href={pathWithBase(href === "/" ? href : `${href}/`)}
      >
        {label}
      </a>
    ))}
  </nav>
  <small class="sidebar-author">{site.author}</small>
</aside>
