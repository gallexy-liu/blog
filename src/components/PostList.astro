---
import { formatDate, type BlogPost } from "@/lib/posts";
import { pathWithBase } from "@/config/site";

type Props = {
  posts: BlogPost[];
  layout?: "articles" | "projects";
};

const { posts, layout = "articles" } = Astro.props;
---

<div class:list={["post-list", layout === "projects" && "project-list"]}>
  {posts.map((post) => (
    <article class:list={["post-card", layout === "projects" && !post.thumbnail && "project-text-only"]}>
      <a class="post-card-link" href={pathWithBase(`/posts/${post.slug}/`)}>
        {layout === "projects" && post.thumbnail && (
          <img class="project-thumbnail" src={pathWithBase(post.thumbnail.src)} alt={post.thumbnail.alt} loading="lazy" />
        )}
        <div class="post-card-body">
          <p class="post-meta">
            <span>{post.sectionName}</span>
            <time datetime={post.date}>{formatDate(post.date)}</time>
          </p>
          <h2>{post.title}</h2>
          <p class="post-card-description">{post.description}</p>
        </div>
      </a>
    </article>
  ))}
</div>
